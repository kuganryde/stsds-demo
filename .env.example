# Copy to .env. Never commit .env or ./secrets. Generate tokens with: openssl rand -hex 32
STSDS_MODE=shadow                 # shadow = draft only. Switch to live only after UAT + Head of Tax sign-off.
STSDS_RULES_PATH=rules/stamp_rules.json
STSDS_STAGING_DIR=/var/lib/stsds/staging
STSDS_MAKER_CHECKER_RM=10000
STSDS_ENABLE_PHASE2=false         # true only for pre-2027 Phase 2 dry runs

# Batch processing and human-in-the-loop
STSDS_AUTO_THRESHOLD=0.95         # document score needed to run without a person (never set below 0.95)
STSDS_BATCH_MAX_DOCS=50           # documents per batch
STSDS_BATCH_CONCURRENCY=4         # documents classified/processed in parallel
STSDS_PORTAL_CONCURRENCY=1        # simultaneous MyTax sessions (keep 1 unless LHDN allows more)
STSDS_BATCH_PAYMENT_CAP_RM=250000 # total duty one batch may file automatically; the rest is held
STSDS_USERS_FILE=                 # JSON of reviewers/checkers (hashed tokens): python -m stsds.users NAME reviewer
STSDS_LEDGER_PATH=/var/lib/stsds/ledger/ledger.jsonl

# Step 1 and step 8
STSDS_MIN_SIGNATURES=1            # live mode requires at least 1 signature on every document
STSDS_QR_VERIFY_HOSTS=            # comma list: host(s) the certificate QR code may point to
SIGNING_URL=                      # e-signature gateway (HTTPS), contract in the README

# Payment provider gateway (HTTPS only). Contract is documented in the README.
PAYMENT_URL=

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
QDRANT_URL=http://qdrant:6333

DATABASE_URL=postgresql://stsds_app:CHANGE_ME@postgres:5432/stsds
STSDS_VAULT_BUCKET=
STSDS_VAULT_KMS_KEY_ID=
AWS_REGION=ap-southeast-5

TIN_VERIFY_URL=                   # LHDN-authorised TIN validation endpoint
TELEGRAM_CHAT_ID=
N8N_PUBLIC_URL=https://stsds.example.com/

# Secrets are injected as files (see docker-compose secrets) or from your secret manager:
# STSDS_ENGINE_TOKEN, STSDS_WEBHOOK_SECRET, TIN_VERIFY_TOKEN, TELEGRAM_BOT_TOKEN, PAYMENT_TOKEN, SIGNING_TOKEN

# Hold documents unless a party is an approved client (set true in production)
STSDS_REQUIRE_CLIENT=false
